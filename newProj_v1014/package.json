{
  "name": "world-execute-me-deepseek-mv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "node server.mjs",
    "export:p0": "node tools/export-p0.mjs",
    "check:p0": "node tools/export-p0.mjs --mode stills",
    "check:p1": "node tools/export-p0.mjs --preset p1 --mode stills",
    "export:p1": "node tools/export-p0.mjs --preset p1",
    "export:p0-p1": "node tools/export-p0.mjs --preset combined",
    "check:p2": "node tools/export-p0.mjs --preset p2 --mode stills",
    "export:p2": "node tools/export-p0.mjs --preset p2",
    "check:p3": "node tools/export-p0.mjs --preset p3 --mode stills",
    "export:p3": "node tools/export-p0.mjs --preset p3",
    "check:p4": "node tools/export-p0.mjs --preset p4 --mode stills",
    "export:p4": "node tools/export-p0.mjs --preset p4",
    "check:p5": "node tools/export-p0.mjs --preset p5 --mode stills",
    "export:p5": "node tools/export-p0.mjs --preset p5",
    "check:p6": "node tools/export-p0.mjs --preset p6 --mode stills",
    "export:p6": "node tools/export-p0.mjs --preset p6",
    "check:p7": "node tools/export-p0.mjs --preset p7 --mode stills",
    "export:p7": "node tools/export-p0.mjs --preset p7",
    "export:full": "node tools/export-p0.mjs --preset full",
    "check:engine": "node tools/check-time-windows.mjs && node tools/check-engine.mjs",
    "review": "node tools/build-review-hub.mjs",
    "check:review": "node tools/check-review-hub.mjs",
    "check:windows": "node tools/check-time-windows.mjs",
    "check:flash": "python tools/check-flash.py",
    "probe": "node tools/probe-times.mjs",
    "motion": "node tools/measure-shot-motion.mjs",
    "audio:features": "python tools/build-audio-features.py --spectrum"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "ffmpeg-static": "^5.3.0"
  }
}
